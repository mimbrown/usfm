{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "USFM Configuration",
  "description": "USFM Configuration File",
  "type": "object",
  "properties": {
    "lexicon": {
      "description": "Where the lexicon information for the project is stored",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "sqlite"
        },
        "path": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "type",
        "path"
      ],
      "additionalProperties": false
    },
    "previews": {
      "description": "The various kinds of previews available",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "includes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "style": {
            "type": "string"
          },
          "replacements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "stylesheets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "title"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}